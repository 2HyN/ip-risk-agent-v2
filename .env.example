# 실제 값은 이 파일에 쓰지 않는다. 이름과 용도만 선언한다.
# 각 Plane 은 환경변수를 직접 읽지 않고 Integration 이 생성자 인자로 주입한다.
# 예외: Intelligence 는 IntelligenceConfig.from_env(env) 로 주입받고,
#      Electron main 은 process.env.IPRISK_SERVER_BASE_URL 을 직접 읽는다.

# Application / Control Plane
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
SESSION_SECRET=
APP_PUBLIC_BASE_URL=
FIRESTORE_DATABASE=

# Firestore emulator — 테스트에서만 사용한다. production 에 설정하지 않는다.
FIRESTORE_EMULATOR_HOST=

# Shared GCP configuration
GCP_PROJECT_ID=

# Cloud Tasks — 넷을 모두 채워야 큐가 붙는다. 없으면 in-memory 로 내려간다.
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
ANALYSIS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=

# Google Drive Source Connector
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_WEBHOOK_BASE_URL=
DRIVE_WATCH_CHANNEL_TOKEN=

# GitHub Source Connector
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_SECRET_ID=
GITHUB_WEBHOOK_SECRET_ID=
#  - 아래 둘이 실제 값이다. 배포가 Secret Manager 에서 읽어 주입한다.
#  - GITHUB_WEBHOOK_SECRET 이 없으면 webhook 라우터를 아예 붙이지 않는다.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CALLBACK_URL=

# Local transient staging
LOCAL_STAGING_BUCKET=

# Electron Desktop — 로컬 앱이 서버를 찾는 주소
IPRISK_SERVER_BASE_URL=

# Intelligence providers
GEMINI_MODEL_ID=
GEMINI_API_KEY=
VERTEX_AI_LOCATION_OR_ENDPOINT_CONFIG=

# KIPRIS
#  - KIPRIS_ACCESS_KEY 가 코드(IntelligenceConfig.from_env)가 읽는 이름이다.
#  - KIPRIS_API_KEY_SECRET_ID 는 Secret Manager 참조 ID 이며,
#    Integration 이 그 값을 읽어 KIPRIS_ACCESS_KEY 로 주입한다.
KIPRIS_ACCESS_KEY=
KIPRIS_API_KEY_SECRET_ID=

# RAG Engine
RAG_REGION=
RAG_CORPUS_ID=
RAG_CORPUS_VERSION=
RAG_MANAGED_DB_CONFIG=
# 관련도가 낮은 조각을 근거로 쓰지 않게 하는 거리 임계값. 기본 0.6.
# 끄려면 none 을 명시한다.
RAG_DISTANCE_THRESHOLD=

# Package metadata provider (기본값 사용 시 비워 둔다)
PACKAGE_METADATA_BASE_URL=
