# Runtime profile
APP_ENV=local
APP_ROLE=api
LOG_LEVEL=INFO

# Application / Control Plane
# Production v2 canonical values (do not use the v1 `(default)` database):
# GCP_PROJECT_ID=proj-aj22-211200020328
# GCP_REGION=asia-northeast3
# FIRESTORE_DATABASE=ip-risk-agent-v2
# LOCAL_STAGING_BUCKET=proj-aj22-211200020328-iprisk-v2-staging
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
FIRESTORE_DATABASE=
FRONTEND_DIST_DIR=
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=

# Test-only emulator; production startup rejects this variable.
FIRESTORE_EMULATOR_HOST=

# Google Drive Source Connector
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_WEBHOOK_BASE_URL=
DRIVE_WATCH_CHANNEL_TOKEN=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# GitHub Source Connector
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_SECRET_ID=
GITHUB_WEBHOOK_SECRET_ID=
GITHUB_APP_CALLBACK_URL=

# Local transient staging / production v2 credential namespace
LOCAL_STAGING_BUCKET=
SOURCE_CREDENTIAL_SECRET_PREFIX=iprisk-v2-cred
IPRISK_SERVER_BASE_URL=http://127.0.0.1:8000
IPRISK_DESKTOP_RENDERER_URL=http://127.0.0.1:5173

# API-only Cloud Tasks / Scheduler settings. Worker must not receive these.
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
ANALYSIS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
SCHEDULER_SERVICE_ACCOUNT=

# Worker-only intelligence providers
VERTEX_AI_LOCATION_OR_ENDPOINT_CONFIG=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=
KIPRIS_API_KEY_SECRET_ID=
KIPRIS_ACCESS_KEY=
RAG_REGION=
RAG_CORPUS_ID=
RAG_CORPUS_VERSION=
PACKAGE_METADATA_BASE_URL=

# Production secret IDs/mappings are fixed by deploy/v2-resource-contract.yaml.
# Never reuse ipra-* or other v1/non-v2 secrets.

