  "dependencies": {
    "@iprisk/contracts": "workspace:*",
    "chokidar": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "43.4.0",
    "typescript": "5.9.3"
  }
}
