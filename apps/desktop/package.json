{
  "name": "@iprisk/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "IP Risk Agent desktop companion — mounts local folders into a Risk Workspace",
  "author": "IP Risk Agent Team 5",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "verify:resolution": "node ../../scripts/verify_typescript_resolution.mjs",
    "test": "node --test \"dist/security/*.test.js\" \"dist/watcher/*.test.js\" \"dist/local-registry/*.test.js\" \"dist/preload/*.test.js\" \"dist/core/*.test.js\" \"dist/main/*.test.js\"",
    "start": "electron .",
    "package": "electron-builder --win zip"
  },
  "dependencies": {
    "@iprisk/contracts": "workspace:*",
    "chokidar": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "43.4.0",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "kr.iprisk.desktop",
    "productName": "IP Risk Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.test.js",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    }
  }
}
