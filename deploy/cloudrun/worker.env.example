# Cloud Run — 분석 워커 서비스 환경변수
#
# 워커는 사용자 세션을 다루지 않으므로 로그인 관련 변수가 필요 없다.
# 대신 분석 provider 자격증명이 여기 들어간다.

# --- 필수 ---
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
APP_PUBLIC_BASE_URL=          # 세션 설정 검증에 쓰인다. API 와 같은 값

# --- Intelligence ---
GEMINI_MODEL_ID=              # 없으면 분석 경로 전체가 비활성화된다
GEMINI_API_KEY=               # Secret. AI Studio 사용 시
VERTEX_AI_LOCATION_OR_ENDPOINT_CONFIG=   # Vertex 사용 시
KIPRIS_ACCESS_KEY=            # Secret. 없으면 특허 경로만 비활성화
RAG_REGION=
RAG_CORPUS_ID=
RAG_CORPUS_VERSION=

# --- Source provider (스냅샷 조회에 필요) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=   # Secret
GOOGLE_DRIVE_REDIRECT_URI=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=       # Secret
LOCAL_STAGING_BUCKET=

# --- 주의 ---
# /internal/analysis/* 는 ingress 에서 차단하고 Cloud Tasks SA 만 호출 가능해야 한다.
