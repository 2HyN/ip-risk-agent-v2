# Cloud Run — API 서비스 환경변수
#
# 값 없이 이름만 둔다. 실제 secret 은 Secret Manager 에 두고
#   gcloud run deploy --set-secrets=NAME=secret-name:latest
# 로 주입한다. 평문 --set-env-vars 로 넣지 않는다.

# --- 필수 ---
APP_PUBLIC_BASE_URL=          # 이 서비스의 공개 HTTPS URL
SESSION_SECRET=               # Secret. 최소 32자. 없으면 재시작마다 전원 로그아웃
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)

# --- Google 로그인 ---
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=   # Secret
GOOGLE_LOGIN_REDIRECT_URI=    # <APP_PUBLIC_BASE_URL>/api/v1/auth/google/callback

# --- Cloud Tasks (워커 배포 후 채운다) ---
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=analysis-queue
ANALYSIS_WORKER_URL=          # <WORKER-URL>/internal/analysis/dispatch
CLOUD_TASKS_SERVICE_ACCOUNT=  # Cloud Tasks 가 워커를 호출할 때 쓸 SA 이메일

# --- Google Drive ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=   # Secret
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_WEBHOOK_BASE_URL=
DRIVE_WATCH_CHANNEL_TOKEN=    # Secret. webhook 발신자 검증용

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=
GITHUB_APP_PRIVATE_KEY=       # Secret. PEM 전문
GITHUB_WEBHOOK_SECRET=        # Secret. 없으면 webhook 라우터를 붙이지 않는다

# --- Local staging ---
LOCAL_STAGING_BUCKET=

# --- 설정하면 안 되는 것 ---
# FIRESTORE_EMULATOR_HOST     production 에 넣으면 실제 DB 를 쓰지 않는다
